# Environment Variables Template for Cypress Testing
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application URL (Replace with your actual staging URL)
BASE_URL=https://staging.yourapp.com

# Test User Credentials (Regular User)
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=your-secure-password-here

# Test Admin Credentials (Replace with your test admin credentials)
TEST_ADMIN_EMAIL=test.admin@example.com
TEST_ADMIN_PASSWORD=your-secure-admin-password-here

# Optional: API Keys (if your app uses them)
# API_KEY=your-api-key-here
# API_SECRET=your-api-secret-here

# Optional: CI/CD Environment Flag
# CI=false

# =============================================
# MongoDB (Test Results Persistence)
# =============================================

# MongoDB connection string for storing test results
# MONGO_URI=mongodb://localhost:27017/wastehero-qa

# QA API URL (Express API for test result persistence)
# Local: http://localhost:3001, CI: via Cloudflare Tunnel
QA_API_URL=http://localhost:3001

# =============================================
# Slack Integration (Phase 1: Bug Notifications)
# =============================================

# Slack Bot OAuth Token (starts with xoxb-)
# Create a Slack App at https://api.slack.com/apps with scopes: chat:write, files:write
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Channel ID (not the channel name!)
# Right-click channel name > "View channel details" > copy the ID at the bottom
SLACK_CHANNEL_ID=C0123456789

# Optional: Slack User Group IDs for @mentioning teams by classification
# Find group IDs via: https://api.slack.com/methods/usergroups.list
# SLACK_BACKEND_GROUP_ID=S0123456789
# SLACK_FRONTEND_GROUP_ID=S9876543210

# Notification mode: "failures-only" (default) or "always"
# SLACK_NOTIFY_MODE=failures-only

# =============================================
# AI Agent (Phase 2: Bug Investigation)
# =============================================

# Anthropic API Key for Claude (used by both agent crews)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# GitHub PAT for WasteHero org (read: investigation, write: PRs)
# WASTEHERO_GITHUB_TOKEN=ghp_your-token-here

# WasteHero app repo in owner/name format
# WASTEHERO_REPO=org/wastehero-app

# Agent model (default: claude-sonnet-4-6)
# AGENT_MODEL=claude-sonnet-4-6

# Max tool calls per investigation (default: 10)
# AGENT_MAX_TOOL_CALLS=10

# Parallel investigations (default: 3)
# AGENT_CONCURRENCY=3

# =============================================
# Slack Interactivity (Approval Webhook)
# =============================================

# Slack sends button clicks (Approve Fix / Skip / Re-run) to your QA API at:
#   POST {QA_API_URL}/api/v1/slack/interactions
# Configure this URL in your Slack App under "Interactivity & Shortcuts"

# =============================================
# Infrastructure (Cloudflare Tunnel)
# =============================================

# Run `docker compose up` — the tunnel service auto-generates a public URL.
# Look for "https://xxxx.trycloudflare.com" in the tunnel container logs.
# Set that URL as QA_API_URL above and in GitHub repo secrets.
#
# For a persistent URL, create a named tunnel:
#   cloudflared tunnel login
#   cloudflared tunnel create qa-api
# Then set the token here and uncomment the named tunnel command in docker-compose.yml
# TUNNEL_TOKEN=your-tunnel-token-here
