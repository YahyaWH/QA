# Environment Variables Template for Cypress Testing
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application URL (Replace with your actual staging URL)
BASE_URL=https://staging.yourapp.com

# Test User Credentials (Regular User)
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=your-secure-password-here

# Test Admin Credentials (Replace with your test admin credentials)
TEST_ADMIN_EMAIL=test.admin@example.com
TEST_ADMIN_PASSWORD=your-secure-admin-password-here

# Optional: API Keys (if your app uses them)
# API_KEY=your-api-key-here
# API_SECRET=your-api-secret-here

# Optional: Database Connection (for seeding/cleanup)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=finance_tracker_test
# DB_USER=test_user
# DB_PASSWORD=test_password

# Optional: Third-party Service Keys
# STRIPE_TEST_KEY=sk_test_xxxxx
# SENDGRID_API_KEY=SG.xxxxx

# Optional: CI/CD Environment Flag
# CI=false

# =============================================
# Google Sheets Integration
# =============================================

# Path to Google Service Account credentials JSON file (for local development)
# Download from Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# Google Sheets Spreadsheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Google Drive Folder ID for artifact uploads (screenshots & videos)
# Create a folder in Google Drive and share it with the service account email.
# The folder ID is the last part of the URL: https://drive.google.com/drive/folders/FOLDER_ID
# Leave empty or unset to skip Drive upload (artifacts will only be in GitHub Actions).
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Note: For CI/CD (GitHub Actions), set these as secrets:
# - GOOGLE_CREDENTIALS (the entire JSON content of the service account file)
# - GOOGLE_SHEET_ID (the spreadsheet ID)
# - GOOGLE_DRIVE_FOLDER_ID (the Drive folder ID for artifacts)
