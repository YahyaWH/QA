# ─── Device ───────────────────────────────────────────────────────────────────
# Path to the Android SDK root (e.g. ~/Library/Android/sdk on macOS)
ANDROID_SDK_ROOT=/path/to/android/sdk
# Name of the AVD to boot (must already exist via `avdmanager list avd`)
ANDROID_AVD_NAME=Pixel_7_API_34
# Absolute path to the WasteHero APK file to install on the emulator
WASTEHERO_APK_PATH=/path/to/wastehero.apk
# Appium server host (default: 127.0.0.1)
APPIUM_HOST=127.0.0.1
# Appium server port (default: 4723)
APPIUM_PORT=4723

# ─── Auth (one set of credentials per role) ────────────────────────────────────
# Admin role credentials
WH_CREDS_ADMIN_EMAIL=###
WH_CREDS_ADMIN_PASSWORD=###
# Driver role credentials
WH_CREDS_DRIVER_EMAIL=###
WH_CREDS_DRIVER_PASSWORD=###
# Dispatcher role credentials
WH_CREDS_DISPATCHER_EMAIL=###
WH_CREDS_DISPATCHER_PASSWORD=###

# ─── Agent ────────────────────────────────────────────────────────────────────
# Anthropic API key (required)
ANTHROPIC_API_KEY=###
# Claude model to use for both Evaluate and Decide (default: claude-opus-4-7)
AGENT_MODEL=claude-opus-4-7
# How often to run a full vision (Evaluate) pass — every N turns (default: 10)
AGENT_VISION_EVERY_N_TURNS=10
# Maximum wall-clock time for a single run, in minutes (default: 30)
AGENT_WALL_CLOCK_MIN=30
# Maximum number of agent turns per run (default: 500)
AGENT_TURN_BUDGET=500
# Comma-separated list of action labels the driver must never execute
DENY_ACTIONS=logout,sign-out,delete-account,delete-customer,delete-route,factory-reset

# ─── Publishing ───────────────────────────────────────────────────────────────
# Linear team ID (fill before first publish)
LINEAR_TEAM_ID=###
# Linear project ID (fill before first publish)
LINEAR_PROJECT_ID=###
# Artifact hosting mode: "github-branch" (default) or "s3"
ARTIFACT_HOST_MODE=github-branch
# Git branch used to host artifacts when ARTIFACT_HOST_MODE=github-branch
ARTIFACT_GITHUB_BRANCH=android-qa-artifacts
# S3 bucket name — only required when ARTIFACT_HOST_MODE=s3
ARTIFACT_S3_BUCKET=###
