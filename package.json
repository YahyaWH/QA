{
  "name": "wastehero-cypress-tests",
  "version": "1.0.0",
  "description": "End-to-end Cypress tests for WasteHero application",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open --config chromeWebSecurity=false",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "cypress:run:edge": "cypress run --browser edge",
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:spec": "cypress run --spec",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:regression": "cypress run --env grepTags=@regression",
    "test:critical": "cypress run --env grepTags=@critical",
    "report:generate": "npx tsx cypress/scripts/generate-report.ts",
    "report:html": "npx tsx cypress/scripts/generate-html-report.ts",
    "report:full": "npm run report:generate && npm run report:html",
    "test:pd042": "cypress run --spec \"cypress/e2e/PD-042/*.cy.ts\" --browser chrome",
    "test:pd042:html": "npm run test:pd042 || true && npm run report:full",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "notify:slack": "npx tsx cypress/scripts/notify-slack.ts",
    "notify:slack:dry": "SLACK_BOT_TOKEN= npx tsx cypress/scripts/notify-slack.ts",
    "notify:slack:mock": "npx tsx -e \"require('fs').copyFileSync('cypress/results/mock-sheets-report.json','cypress/results/sheets-report.json')\" && npx tsx cypress/scripts/notify-slack.ts",
    "gc:mark": "npx tsx cypress/scripts/gc/mark.ts",
    "gc:sweep": "npx tsx cypress/scripts/gc/sweep.ts",
    "onboarding:discover": "npx tsx scripts/onboarding/discover.ts",
    "onboarding:video:export": "npx tsx scripts/onboarding/videos/export-to-excel.ts",
    "onboarding:video:create-container": "npx tsx scripts/onboarding/videos/create-container.ts",
    "onboarding:video:change-language": "npx tsx scripts/onboarding/videos/change-language.ts",
    "onboarding:video:impersonate-user": "npx tsx scripts/onboarding/videos/impersonate-user.ts",
    "onboarding:video:customer-service": "npx tsx scripts/onboarding/videos/customer-service-lookup.ts"
  },
  "keywords": [
    "cypress",
    "e2e",
    "testing",
    "wastehero"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cypress": "^13.17.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.15.1",
    "mochawesome": "^7.1.3",
    "playwright": "^1.59.1",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@playwright/mcp": "^0.0.70",
    "@slack/web-api": "^7.14.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  }
}
