{
  "name": "finance-tracker-cypress-tests",
  "version": "1.0.0",
  "description": "End-to-end Cypress tests for Finance Tracker application",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open --config chromeWebSecurity=false",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "cypress:run:edge": "cypress run --browser edge",
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:spec": "cypress run --spec",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:regression": "cypress run --env grepTags=@regression",
    "test:critical": "cypress run --env grepTags=@critical",
    "sheets:generate": "npx tsx cypress/scripts/generate-report.ts",
    "sheets:upload": "npx tsx cypress/scripts/upload-to-sheets.ts",
    "sheets:artifacts": "npx tsx cypress/scripts/generate-artifact-urls.ts",
    "sheets:full": "npm run sheets:generate && npm run sheets:upload",
    "report:html": "npx tsx cypress/scripts/generate-html-report.ts",
    "report:full": "npm run sheets:generate && npm run report:html",
    "test:pd042": "cypress run --spec \"cypress/e2e/PD-042/*.cy.ts\" --browser chrome",
    "test:pd042:html": "npm run test:pd042 || true && npm run report:full",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cypress",
    "e2e",
    "testing",
    "finance-tracker"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cypress": "^13.17.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.15.1",
    "googleapis": "^128.0.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "plantuml": "^0.0.2",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
